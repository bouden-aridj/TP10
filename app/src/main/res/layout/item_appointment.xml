<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg"
    android:padding="16dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <!-- Top Row: Patient Name & Status -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/tvStatus"
            android:text="John Doe"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Scheduled"
            android:textColor="@color/on_primary"
            android:background="@color/status_scheduled"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </RelativeLayout>

    <!-- Patient Details -->
    <TextView
        android:id="@+id/tvPatientInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="john@example.com • 555-0192 • 35 yrs (Male)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/input_bg"
        android:layout_marginBottom="8dp" />

    <!-- Doctor & Specialty -->
    <TextView
        android:id="@+id/tvDoctorSpecialty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dr. Sarah Connor — Cardiology"
        android:textColor="@color/lavender_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Date & Time -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 2025-04-20 🕒 10:30"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <!-- Notes & Delete Action Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnDelete"
            android:layout_centerVertical="true"
            android:text="Notes: Follow up checkup"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/error_red"
            android:contentDescription="Delete" />
    </RelativeLayout>

</LinearLayout>
